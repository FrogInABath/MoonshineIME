<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/darkGrey"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:padding="0dp">

    <!-- Slim 3dp Progress Bar pinned across the top edge -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/colorAccent"
        android:progressBackgroundTint="@color/lightGrey"
        android:indeterminateTint="@color/colorAccent" />

    <!-- 51dp Toolbar (+15% height expansion from 44dp) -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Switch back to standard/T9 keyboard -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:text="⌨"
            android:textColor="#B0BEC5"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/exit_button" />

        <!-- Acorn Comma -->
        <com.whispertflite.AcornButton
            android:id="@+id/btnPunctComma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text=","
            android:textColor="#FFFDD0"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingTop="5dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:contentDescription="Comma" />

        <!-- Acorn Period -->
        <com.whispertflite.AcornButton
            android:id="@+id/btnPunctPeriod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="."
            android:textColor="#FFFDD0"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingTop="3dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:contentDescription="Period" />

        <!-- Acorn Question Mark -->
        <com.whispertflite.AcornButton
            android:id="@+id/btnPunctQuestion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#FFFDD0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:contentDescription="Question Mark" />

        <!-- Acorn Exclamation Point -->
        <com.whispertflite.AcornButton
            android:id="@+id/btnPunctExclamation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFFDD0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:contentDescription="Exclamation Point" />

        <!-- Acorn Apostrophe -->
        <com.whispertflite.AcornButton
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="'"
            android:textColor="#FFFDD0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="2dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:contentDescription="Apostrophe" />

        <!-- Backspace with Repeat Hold -->
        <TextView
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#FF8A80"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/delete_button" />

        <!-- Enter / Return -->
        <TextView
            android:id="@+id/btnEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:text="↵"
            android:textColor="#80D8FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/return_button" />

        <!-- Compact Recording Indicator & Touch Fallback -->
        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text="🎙"
            android:textColor="#78909C"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <!-- Invisible placeholder retained to prevent NullPointerExceptions in legacy methods -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
