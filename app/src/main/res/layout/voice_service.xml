<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#151915"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="#1E2A20"
        android:indeterminateTint="#76C843" />

    <!-- Spiraling Oak Branch Separator -->
    <ImageView
        android:id="@+id/banner_branch"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:scaleType="fitXY"
        android:src="@drawable/banner_spiral_branch"
        android:contentDescription="Spiraling Branch Banner" />

    <!-- Expanded 54dp Toolbar Deck -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <!-- Keyboard Switch Acorn -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:text="⌨"
            android:textColor="#FFE082"
            android:textSize="13sp"
            android:shadowColor="#FF8F00"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap"
            android:contentDescription="@string/exit_button" />

        <!-- Comma Acorn -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:text=","
            android:textColor="#FFE082"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#FF8F00"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap" />

        <!-- Period Acorn -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="11dp"
            android:text="."
            android:textColor="#FFE082"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#FF8F00"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap" />

        <!-- Question Mark Acorn -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="15dp"
            android:text="?"
            android:textColor="#FFE082"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#FF8F00"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap" />

        <!-- Exclamation Mark Acorn -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="15dp"
            android:text="!"
            android:textColor="#FFE082"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#FF8F00"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap" />

        <!-- Apostrophe Acorn -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="37dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center_horizontal"
            android:paddingTop="15dp"
            android:text="'"
            android:textColor="#FFE082"
            android:textSize="19sp"
            android:textStyle="bold"
            android:shadowColor="#FF8F00"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/acorn_keycap" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Sacred Geometry Spiral Coin (Proportionally Scaled to 46dp) -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:padding="0dp"
            android:src="@drawable/ic_silver_coin_cybersigil"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
