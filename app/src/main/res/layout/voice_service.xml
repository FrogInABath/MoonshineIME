<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_canvas_deck"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="#7D6242"
        android:indeterminateTint="#76FF03" />

    <!-- Ancient Gnarled Oak Branch Separator -->
    <ImageView
        android:id="@+id/banner_branch"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/banner_spiral_branch"
        android:contentDescription="Ancient Branch Banner" />

    <!-- 52dp Stone Rune Toolbar Deck -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- 1. Keyboard Switch: Hexagon Basalt (Inlaid Ruby Red) -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="2dp"
            android:text="⌨"
            android:textColor="#FF3B56"
            android:textSize="14sp"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_hex"
            android:contentDescription="@string/exit_button" />

        <!-- 2. Comma: River Pebble Slate (Inlaid Amber Orange) -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text=","
            android:textColor="#FF8800"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_pebble" />

        <!-- 3. Period: Disc Stone (Inlaid Sunstone Yellow) -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="."
            android:textColor="#FFD600"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_disc" />

        <!-- 4. Question Mark: Rhombus Lodestone (Inlaid Jade Green) -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="2dp"
            android:text="?"
            android:textColor="#00E676"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_diamond" />

        <!-- 5. Exclamation Mark: Keystone Obelisk (Inlaid Azure Blue) -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="2dp"
            android:text="!"
            android:textColor="#00B0FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_pillar" />

        <!-- 6. Apostrophe: Shield Stone (Inlaid Amethyst Violet) -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingBottom="3dp"
            android:text="'"
            android:textColor="#D500F9"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#050608"
            android:shadowRadius="3"
            android:shadowDx="-1"
            android:shadowDy="-2"
            android:background="@drawable/rune_stone_shield" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Sacred Geometry Silver Coin Action Button -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter"
            android:padding="0dp"
            android:src="@drawable/ic_silver_coin_cybersigil"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
