<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_banner"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Slim 3dp Progress Bar across the top edge -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#76C843"
        android:progressBackgroundTint="#1E3320"
        android:indeterminateTint="#A9E04B" />

    <!-- 48dp 8-Bit Forest Toolbar -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <!-- Keyboard Switch -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="⌨"
            android:textColor="#E8D5B7"
            android:textSize="17sp"
            android:background="@drawable/pixel_keycap_bg"
            android:contentDescription="@string/exit_button" />

        <!-- Comma -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text=","
            android:textColor="#FFF4E0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_keycap_bg" />

        <!-- Period -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="."
            android:textColor="#FFF4E0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_keycap_bg" />

        <!-- Question Mark -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#FFF4E0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_keycap_bg" />

        <!-- Exclamation Mark -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFF4E0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_keycap_bg" />

        <!-- Apostrophe -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="'"
            android:textColor="#FFF4E0"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_keycap_bg" />

        <!-- Enlarged Oak Leaf Microphone Button -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_oak_leaf"
            android:background="@drawable/pixel_keycap_bg"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
