<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/darkGrey"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Slim 3dp Progress Bar pinned across the top edge -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/colorAccent"
        android:progressBackgroundTint="@color/lightGrey"
        android:indeterminateTint="@color/colorAccent" />

    <!-- Compact 44dp Toolbar replacing the large multi-row mic layout -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Switch back to standard/T9 keyboard -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:text="⌨"
            android:textColor="#B0BEC5"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/exit_button" />

        <!-- Comma -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text=","
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Period -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text="."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Question Mark -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text="?"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Exclamation Point -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Apostrophe -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:gravity="center"
            android:text="'"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Backspace with Repeat Hold -->
        <TextView
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#FF8A80"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/delete_button" />

        <!-- Enter / Return -->
        <TextView
            android:id="@+id/btnEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:text="↵"
            android:textColor="#80D8FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/return_button" />

        <!-- Compact Recording Indicator & Touch Fallback -->
        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:gravity="center"
            android:text="🎙"
            android:textColor="#78909C"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/record_button" />

        <!-- Spinning Acorn Action Button -->
        <org.woheller69.whisper.AcornButton
            android:id="@+id/btnAcorn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Acorn Action" />

    </LinearLayout>

    <!-- Invisible placeholder retained to prevent NullPointerExceptions in legacy methods -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
