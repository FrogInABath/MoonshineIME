<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_banner"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="#1E2A20"
        android:indeterminateTint="#76C843" />

    <!-- 50dp Toolbar Deck -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Keyboard Switch -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="⌨"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#000000"
            android:shadowRadius="3"
            android:shadowDy="1"
            android:background="@drawable/acorn_keycap"
            android:contentDescription="@string/exit_button" />

        <!-- Comma -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:text=","
            android:textColor="#FFFEEA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDy="2"
            android:background="@drawable/acorn_keycap" />

        <!-- Period -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="."
            android:textColor="#FFFEEA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDy="2"
            android:background="@drawable/acorn_keycap" />

        <!-- Question Mark -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="?"
            android:textColor="#FFFEEA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDy="2"
            android:background="@drawable/acorn_keycap" />

        <!-- Exclamation Mark -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="!"
            android:textColor="#FFFEEA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDy="2"
            android:background="@drawable/acorn_keycap" />

        <!-- Apostrophe -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="'"
            android:textColor="#FFFEEA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDy="2"
            android:background="@drawable/acorn_keycap" />

        <!-- Space filling between acorns and action coin -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- HD Cybersigil Silver Coin Action Key -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter"
            android:padding="0dp"
            android:src="@drawable/ic_silver_coin_cybersigil"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
