<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_banner"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Slim Progress Bar -->
    <ProgressBar
        android:id="@+id/processing_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#76C843"
        android:progressBackgroundTint="#1E3320"
        android:indeterminateTint="#A9E04B" />

    <!-- 52dp Acorn Deck Toolbar -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Keyboard Switch Acorn -->
        <TextView
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:text="⌨"
            android:textColor="#FFFDF0"
            android:textSize="15sp"
            android:background="@drawable/acorn_keycap"
            android:contentDescription="@string/exit_button" />

        <!-- Comma Acorn -->
        <TextView
            android:id="@+id/btnPunctComma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text=","
            android:textColor="#FFFDF0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/acorn_keycap" />

        <!-- Period Acorn -->
        <TextView
            android:id="@+id/btnPunctPeriod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text="."
            android:textColor="#FFFDF0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/acorn_keycap" />

        <!-- Question Mark Acorn -->
        <TextView
            android:id="@+id/btnPunctQuestion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:text="?"
            android:textColor="#FFFDF0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/acorn_keycap" />

        <!-- Exclamation Mark Acorn -->
        <TextView
            android:id="@+id/btnPunctExclamation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:text="!"
            android:textColor="#FFFDF0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/acorn_keycap" />

        <!-- Apostrophe Acorn -->
        <TextView
            android:id="@+id/btnPunctApostrophe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:text="'"
            android:textColor="#FFFDF0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/acorn_keycap" />

        <!-- Oak Leaf Acorn Mic Button -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="2dp"
            android:scaleType="centerInside"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_oak_leaf"
            android:background="@drawable/acorn_keycap"
            android:contentDescription="@string/record_button" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
