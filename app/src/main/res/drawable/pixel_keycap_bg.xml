<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (sunken 8-bit tile) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2A1B10" />
                    <stroke android:width="2dp" android:color="#140D07" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state (chunky acorn wood tile with bottom drop shadow) -->
    <item>
        <layer-list>
            <!-- 8-Bit Drop Shadow -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#140D07" />
                </shape>
            </item>
            <!-- Acorn Wood Surface -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#462E1C" />
                    <stroke android:width="2dp" android:color="#21150C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
